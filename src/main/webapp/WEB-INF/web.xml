<?xml version="1.0" encoding="ISO-8859-1"?>
<web-app xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
	xmlns="http://java.sun.com/xml/ns/j2ee" xmlns:javaee="http://java.sun.com/xml/ns/javaee" 
	xmlns:web="http://java.sun.com/xml/ns/javaee/web-app_2_5.xsd" 
	xsi:schemaLocation="http://java.sun.com/xml/ns/j2ee http://java.sun.com/xml/ns/j2ee/web-app_2_4.xsd" 
	version="2.4">
	<display-name>Rendiciones de Gastos</display-name>
	<!-- Configuraciï¿½n de listener de session, se encarga de detectar una nueva 
		session e inyectarle el objeto IWebClient configurado en la aplicaciï¿½n. Para 
		aplicaciones que usen WebSphere >= 6.0 Para aplicaciones que hagan uso de 
		los objetos IWebApplication e IWebClient provistos por la librerï¿½a CNLS_BBVAWeb. -->
	<listener>
		<listener-class>ar.com.bbva.web.impl.WebSessionListener</listener-class>
		<!-- <listener-class>com.sa.su.listener.MyWebSessionListener</listener-class> -->
	</listener>
	<!-- Configuraciï¿½n de listener de session - Fin -->

	<!-- Filtro de Seguridad para automatizar el control de usuarios logueados. 
		Sï¿½lo si se usan los objetos IWebApplication e IWebClient provistos por la 
		librerï¿½a CNLS_BBVAWeb. -->
	<filter>
		<filter-name>WebSecurityFilter</filter-name>
		<filter-class>ar.com.bbva.web.impl.WebSecurityFilter</filter-class>
		<init-param>
			<param-name>noLoginPageExpr</param-name>
			<param-value>*/NL-*</param-value>
		</init-param>
	</filter>


	<!-- Sï¿½ SUBIR ESTO AL AMBIENTE DE WebSphere y descomentarlo!!! -->
	<filter>
		<filter-name>ResponseOverrideFilter</filter-name>
		<filter-class>org.displaytag.filter.ResponseOverrideFilter</filter-class>
	</filter>
	<filter-mapping>
		<filter-name>ResponseOverrideFilter</filter-name>
		<url-pattern>*.do</url-pattern>
	</filter-mapping>
	<filter-mapping>
		<filter-name>ResponseOverrideFilter</filter-name>
		<url-pattern>*.jsp</url-pattern>
	</filter-mapping>
	
	
	
	
	<!-- NO SUBIR ESTO AL AMBIENTE DE WebSphere!!! Solo para que se pueda resolver 
		localmente bien el tema del contenido estï¿½tico y que no lo derive a la pï¿½gina 
		de login. -->

	<!-- <filter-mapping> <filter-name>WebSecurityFilter</filter-name> <url-pattern>*.jsp</url-pattern> 
		</filter-mapping> <filter-mapping> <filter-name>WebSecurityFilter</filter-name> 
		<url-pattern>*.do</url-pattern> </filter-mapping> -->
	<!-- NO SUBIR ESTO AL AMBIENTE DE WebSphere!!! - Fin -->
	<!-- Filtro de Seguridad para el control de usuarios logueados - Fin -->


	<!-- Configuarar pÃ¡ginas jsp en UTF-8 -->
	<jsp-config>
		<jsp-property-group>
			<url-pattern>*.jsp</url-pattern>
			<page-encoding>UTF-8</page-encoding>
		</jsp-property-group>
	</jsp-config>


	<!-- Configuraciï¿½n del Servlet de arranque e inicializaciï¿½n de la aplicaciï¿½n 
		y el archivo .properties inicial -->
	<context-param>
		<param-name>syscfgpath</param-name>
		<param-value>${realpath}../syscfg</param-value>
	</context-param>

	<servlet>
		<servlet-name>WebApplicationInitServlet</servlet-name>
		<servlet-class>ar.com.bbva.web.servlets.WebAppInitServlet</servlet-class>
		<init-param>
			<param-name>syscfg-file</param-name>
			<param-value>${syscfgpath}/syscfg.properties</param-value>
		</init-param>
		<init-param>
			<param-name>log-stdout</param-name>
			<param-value>TRUE</param-value>
		</init-param>
		<load-on-startup>1</load-on-startup>
	</servlet>
	<!-- Configuraciï¿½n del Servlet de arranque e inicializaciï¿½n de la aplicaciï¿½n 
		- Fin -->


	<!-- Configuracion de servlet de struts -->
	<servlet>
		<servlet-name>action</servlet-name>
		<servlet-class>org.apache.struts.action.ActionServlet</servlet-class>
		<init-param>
			<param-name>config</param-name>
			<param-value>/WEB-INF/struts-config.xml</param-value>
		</init-param>
		<load-on-startup>1</load-on-startup>
	</servlet>
	<!-- Configuracion de servlet de struts - Fin -->


