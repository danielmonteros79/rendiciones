	<!-- Servlet para servir archivos estáticos -->
	<servlet>
		<servlet-name>fileEnabler</servlet-name>
		<servlet-class>com.sa.util.fileEnabler</servlet-class>
	</servlet>
	
	<!-- Mapeos para archivos estáticos -->
	<servlet-mapping>
		<servlet-name>fileEnabler</servlet-name>
		<url-pattern>*.css</url-pattern>
	</servlet-mapping>
	<servlet-mapping>
		<servlet-name>fileEnabler</servlet-name>
		<url-pattern>*.js</url-pattern>
	</servlet-mapping>
	<servlet-mapping>
		<servlet-name>fileEnabler</servlet-name>
		<url-pattern>*.gif</url-pattern>
	</servlet-mapping>
	<servlet-mapping>
