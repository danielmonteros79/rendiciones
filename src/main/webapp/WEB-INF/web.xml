	<!-- Configuarar páginas jsp en UTF-8 -->
	<jsp-config>
		<jsp-property-group>
			<url-pattern>*.jsp</url-pattern>
			<page-encoding>UTF-8</page-encoding>
		</jsp-property-group>
	</jsp-config>


	<!-- Configuraci�n del Servlet de arranque e inicializaci�n de la aplicaci�n 
		y el archivo .properties inicial -->
	<context-param>
		<param-name>syscfgpath</param-name>
		<param-value>${realpath}../syscfg</param-value>
	</context-param>

	<servlet>
		<servlet-name>WebApplicationInitServlet</servlet-name>
		<servlet-class>ar.com.bbva.web.servlets.WebAppInitServlet</servlet-class>
		<init-param>
			<param-name>syscfg-file</param-name>
			<param-value>${syscfgpath}/syscfg.properties</param-value>
		</init-param>
		<init-param>
			<param-name>log-stdout</param-name>
			<param-value>TRUE</param-value>
		</init-param>
		<load-on-startup>1</load-on-startup>
	</servlet>
	<!-- Configuraci�n del Servlet de arranque e inicializaci�n de la aplicaci�n 
		- Fin -->


	<!-- Configuracion de servlet de struts -->
	<servlet>
		<servlet-name>action</servlet-name>
		<servlet-class>org.apache.struts.action.ActionServlet</servlet-class>
		<init-param>
			<param-name>config</param-name>
			<param-value>/WEB-INF/struts-config.xml</param-value>
		</init-param>
		<load-on-startup>1</load-on-startup>
	</servlet>
	<!-- Configuracion de servlet de struts - Fin -->


	<!-- Si se van a exponer Web Services agregar ac� las cosas de Axis NOTA: 
		No exponer los servlets de administraci�n de axis, etc. -->



	<!-- Servlet para servir archivos estáticos en WebSphere -->
	<servlet>
		<servlet-name>fileEnabler</servlet-name>
		<servlet-class>com.sa.util.fileEnabler</servlet-class>
	</servlet>

	<!-- Mapeos del fileEnabler para recursos estáticos -->
	<servlet-mapping>
		<servlet-name>fileEnabler</servlet-name>
		<url-pattern>/static/*</url-pattern>
	</servlet-mapping>
	
	<servlet-mapping>
		<servlet-name>fileEnabler</servlet-name>
		<url-pattern>/css/*</url-pattern>
	</servlet-mapping>
	
	<servlet-mapping>
		<servlet-name>fileEnabler</servlet-name>
		<url-pattern>/js/*</url-pattern>
	</servlet-mapping>
	
	<servlet-mapping>
		<servlet-name>fileEnabler</servlet-name>
		<url-pattern>/images/*</url-pattern>
	</servlet-mapping>
	
	<servlet-mapping>
		<servlet-name>fileEnabler</servlet-name>
		<url-pattern>/fonts/*</url-pattern>
	</servlet-mapping>
	
	<servlet-mapping>
		<servlet-name>fileEnabler</servlet-name>
		<url-pattern>*.ico</url-pattern>
	</servlet-mapping>
	
	<servlet-mapping>
		<servlet-name>fileEnabler</servlet-name>
		<url-pattern>*.html</url-pattern>
	</servlet-mapping>
	
	<servlet-mapping>
		<servlet-name>fileEnabler</servlet-name>
		<url-pattern>*.js</url-pattern>
	</servlet-mapping>	<!-- Asegúrate de que este mapeo esté DESPUÉS de los mapeos de recursos estáticos -->
	<servlet-mapping>
		<servlet-name>action</servlet-name>
		<url-pattern>*.do</url-pattern>
	</servlet-mapping>
	<!-- Configuraci�n de mapping de struts - Fin -->


	<welcome-file-list>
		<welcome-file>index.jsp</welcome-file>
	</welcome-file-list>
</web-app>