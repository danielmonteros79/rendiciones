<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE struts-config PUBLIC "-//Apache Software Foundation//DTD Struts Configuration 1.3//EN"
       						   "http://struts.apache.org/dtds/struts-config_1_3.dtd">
<struts-config>
	<form-beans>
		<form-bean name="LoginForm" type="com.sa.form.LoginForm" />
		<form-bean name="RendicionForm" type="com.sa.form.RendicionForm" />
		<form-bean name="DelegadosForm" type="com.sa.form.DelegadosAsignadosForm" />
		<form-bean name="RendicionDetalleForm" type="com.sa.form.RendicionDetalleForm" />
		<form-bean name="CuponesForm" type="com.sa.form.CuponesForm" />
		<form-bean name="AprobarRendicionForm" type="com.sa.form.AprobacionForm" />
		<form-bean name="CierreFiltroForm" type="com.sa.form.CierreFiltroForm" />
		<form-bean name="CierreForm" type="com.sa.form.CierreForm" />
		<form-bean name="ResumenForm" type="com.sa.form.ResumenForm"/>
		<form-bean name="ImagenesForm" type="com.sa.form.RendicionAvisoForm" />
		<form-bean name="ParametrosMotivoForm" type="com.sa.form.parametros.ParametrosMotivoForm" />
		<form-bean name="ParametrosMotivoFiltroForm" type="com.sa.form.parametros.ParametrosMotivoFiltroForm" />
		<form-bean name="ParametrosGastosForm" type="com.sa.form.parametros.ParametrosGastosForm" />
		<form-bean name="ParametrosGastosFiltroForm" type="com.sa.form.parametros.ParametrosGastosFiltroForm" />
		<form-bean name="AbmDelegadoForm" type="com.sa.form.delegacion.AbmDelegadoForm" />
		<form-bean name="ParametrosAlertasForm" type="com.sa.form.parametros.ParametrosAlertasForm" />
		<form-bean name="ParametrosAlertasFiltroForm" type="com.sa.form.parametros.ParametrosAlertasFiltroForm" />
		<form-bean name="ParametrosExceptuadosForm" type="com.sa.form.parametros.ParametrosExceptuadosForm" />
		<form-bean name="ParametrosExceptuadosFiltroForm" type="com.sa.form.parametros.ParametrosExceptuadosFiltroForm" />
		<form-bean name="CuadroGeneralForm" type="com.sa.form.CuadroGeneralForm" />
		<form-bean name="CuadroFiltroForm" type="com.sa.form.CuadroFiltroForm" />
		<form-bean name="AlertaForm" type = "com.sa.form.AlertaForm" />
	</form-beans>

	<global-exceptions>
		<exception key="lang.Exception" type="java.lang.Exception"
			handler="com.sa.core.ManejadorExcepciones" />
	</global-exceptions>
	<global-forwards>
		<forward name="login" path="/login.jsp"></forward>
<!-- 		<forward name="inicio" path="inicioApp"></forward> -->
		<forward name="permisoDenegado" path="permisoDenegado"></forward>
		<!-- 			contextRelative="true">-->
		<forward name="errorService" path="errorService"></forward>
		<forward name="sessionTimeOut" path="timeOutSession"></forward>
		<!-- 			contextRelative="true">-->
	</global-forwards>
	<!-- ========== Users Forward Definitions =============================== -->
	<action-mappings>
		<action path="/Login" type="com.sa.core.PuntoEntradaAction"
			name="LoginForm" className="com.sa.core.SecurityActionMapping" input="login.jsp">
			<set-property value="1" property="applicationZone" />
			<forward name="success" path="/bienvenida.do" />
			<forward name="aprob1" path="/listadoAprobacion.do?glg=1" />
			<forward name="aprob2" path="/listadoAprobacion.do?glg=2" />
			<forward name="aprob3" path="/listadoAprobacion.do?glg=3" />
			<forward name="cierre" path="/cierreOrdenDePago.do" />
			<forward name="failure" path="/error.jsp" />
		</action>
		<action path="/logout" type="com.sa.action.LogoutAction"
			className="com.sa.core.SecurityActionMapping">
			<set-property value="1" property="applicationZone" />
			<forward name="success" path="/timeOut.jsp" />
		</action>
		<action path="/bienvenida" type="com.sa.action.GenericAction" className="com.sa.core.SecurityActionMapping">
			<forward name="success" path="inicioApp" />
		</action>
		<action path="/listadoRendiciones" type="com.sa.action.rendiciones.ListadoRendicionesAction">
			<forward name="ok" path="listadoRendiciones"></forward>
			<forward name="rendiciones" path="/pages/rendiciones/dtRendiciones.jsp"/>
		</action>
		<action path="/altaRendicion" type="com.sa.action.rendiciones.RendicionLoadAction" name="RendicionForm">
			<forward name="success" path="rendicionDetalle" />
		</action>
		<action path="/saveRendicion" type="com.sa.action.rendiciones.RendicionSaveAction" name="RendicionForm">
			<forward name="detalleGastos" path="/rendicionDetalleGastos.do" />
			<forward name="success" path="/listadoRendiciones.do" />
			<forward name="failure" path="rendicionDetalle" />
		</action>
		<action path="/rendicionDetalleGastos" type="com.sa.action.rendiciones.RendicionDetalleGastosAction"
			className="com.sa.core.SecurityActionMapping" name="RendicionForm">
			<forward name="rendicionDetalleGastos" path="showDetalleGastos"></forward>
			<forward name="gastos" path="/pages/global/dtGastos.jsp"/>
			<forward name="consumosPendientes" path="/pages/rendiciones/dtConsumosPendientes.jsp"/>
		</action>
		<action path="/datosAdicionales" type="com.sa.action.DatosAdicionalesAction" className="com.sa.core.SecurityActionMapping"></action>
		<action path="/gastos" type="com.sa.action.GastosAction" name="RendicionDetalleForm"></action>
		<action path="/cuponesPopup" type="com.sa.action.CuponesAction" className="com.sa.core.SecurityActionMapping" name="CuponesForm"></action>
		<action path="/accesoDelegado" type="com.sa.action.delegacion.AccesoDelegadoAction" className="com.sa.core.SecurityActionMapping">
			<forward name="success" path="accesoDelegado" />
		</action>
		<action path="/abmDelegado" type="com.sa.action.delegacion.AbmDelegadoAction" name="AbmDelegadoForm">
			<forward name="success" path="abmDelegado" />
			<forward name="delegados" path="/pages/delegacion/dtDelegados.jsp"/>
		</action>
		<action path="/listadoAprobaciones" type="com.sa.action.aprobacion.ListadoAprobacionesAction" className="com.sa.core.SecurityActionMapping">
			<forward name="success" path="listadoAprobaciones"/>
			<forward name="aprobaciones" path="/pages/aprobacion/dtAprobaciones.jsp"/>
		</action>
		<action path="/aprobacionDetalle" type="com.sa.action.aprobacion.AprobacionDetalleAction" className="com.sa.core.SecurityActionMapping" name="RendicionForm">
			<forward name="success" path="aprobacionDetalle"/>
			<forward name="gastos" path="/pages/global/dtGastos.jsp"/>
		</action>
		<action path="/redistribucionGastos" type="com.sa.action.RedistribucionGastosLoadAction"
			className="com.sa.core.SecurityActionMapping" name="RendicionForm">
			<forward name="success" path="redistribucionGastos"></forward>
		</action>
		<action path="/journal" type="com.sa.action.JournalAction" className="com.sa.core.SecurityActionMapping"></action>
		
		<action path="/cierreOrdenDePago" type="com.sa.action.cierre.CierreOrdenDePagoAction" className="com.sa.core.SecurityActionMapping">
			<forward name="success" path="cierreOrdenDePago"></forward>
			<forward name="cierreOrdenDePago" path="/pages/cierre/dtCierreOrdenDePago.jsp"/>
		</action>
		<action path="/reasignarBandeja" type="com.sa.action.cierre.ReasignarBandejaAction" className="com.sa.core.SecurityActionMapping">
			<forward name="success" path="reasignarBandeja"></forward>
		</action>
		
		<action path="/consumosSinRendir" type="com.sa.action.cierre.ConsumosNoRendidosAction" className="com.sa.core.SecurityActionMapping">
			<forward name="success" path="consumosSinRendir"></forward>
			<forward name="consumosSinRendir" path="/pages/cierre/dtConsumosNoRendidos.jsp"/> 
		</action>
		<action path="/aprobacionesPendientes" type="com.sa.action.cierre.AprobacionesPendientesAction" className="com.sa.core.SecurityActionMapping">
			<forward name="success" path="aprobacionesPendientes"></forward>
			<forward name="aprobacionesPendientes" path="/pages/cierre/dtAprobacionesPendientes.jsp"/> 
		</action>
		
		<action path="/cierreDetalle" type="com.sa.action.cierre.CierreDetalleAction" className="com.sa.core.SecurityActionMapping" name="RendicionForm">
			<forward name="success" path="cierreDetalle"/>
			<forward name="gastos" path="/pages/global/dtGastos.jsp"/>
		</action>
		<action path="/cierreTarjeta" type="com.sa.action.cierre.CierreTarjetaAction" className="com.sa.core.SecurityActionMapping">
			<forward name="success" path="cierreTarjeta"></forward>
			<forward name="cierreTarjeta" path="/pages/cierre/dtCierreTarjeta.jsp"/>
		</action>
		<action path="/CierreDiario" type="com.sa.action.CierreDiarioAction"
			className="com.sa.core.SecurityActionMapping" name="CierreFiltroForm">
			<forward name="success" path="CierreDiario"></forward>
		</action>
		<action path="/ReactivacionSuspensos" type="com.sa.action.ReactivacionSuspensosAction"
			className="com.sa.core.SecurityActionMapping" name="CierreFiltroForm">
			<forward name="success" path="ReactivacionSuspensos"></forward>
		</action>
		<action path="/CierreMensualFormal" type="com.sa.action.CierreMensualFormalAction"
			className="com.sa.core.SecurityActionMapping" name="CierreFiltroForm">
			<forward name="success" path="CierreMensualFormal"></forward>
		</action>
		<action path="/CierreMensualSimulado" type="com.sa.action.CierreMensualSimuladoAction"
			className="com.sa.core.SecurityActionMapping" name="CierreFiltroForm">
			<forward name="success" path="CierreMensualSimulado"></forward>
		</action>
		<action path="/CierreMensualContable" type="com.sa.action.CierreMensualContableAction"
			className="com.sa.core.SecurityActionMapping" name="CierreFiltroForm">
			<forward name="success" path="CierreMensualContable"></forward>
		</action>
		<action path="/consumosNoRendidos" type="com.sa.action.tarjetaCorporativa.ConsumosNoRendidosAction" className="com.sa.core.SecurityActionMapping">
			<forward name="success" path="consumosNoRendidos"></forward>
			<forward name="consumos" path="/pages/tarjetaCorporativa/dtConsumosNoRendidos.jsp"/>
		</action>
		<action path="/resumenesAnteriores" type="com.sa.action.tarjetaCorporativa.ResumenesAnterioresAction" className="com.sa.core.SecurityActionMapping">
			<forward name="success" path="resumenesAnteriores"></forward>
			<forward name="resumen" path="/pages/tarjetaCorporativa/dtResumenesAnteriores.jsp"/>
		</action>
		
		<action path="/imagenes" type="com.sa.action.ImagenesAction" name="ImagenesForm">
		</action>
		
		<!-- LISTADO ALERTAS-->
		<action path="/listadoAlertas" type="com.sa.action.alertas.ListadoAlertasAction" className="com.sa.core.SecurityActionMapping" name="AlertaForm">
			<forward name="success" path="listadoAlertas"></forward>
			<forward name="rendiciones" path="/pages/alertas/dtListadoAlertas.jsp"/>
		</action>
		
		<action path="/detalleAlerta" type="com.sa.action.alertas.DetalleAlertaAction" className="com.sa.core.SecurityActionMapping" name="AlertaForm">
			<forward name="success" path="detalleAlerta"></forward>
			<forward name="rendiciones" path="/pages/alertas/dtDetalleAlerta.jsp"/>
		</action>
	
		<!-- DETALLE DE ALERTA -->
		
		<!-- PARAMETRIA ============================================= -->
		<action path="/parametrosMotivo"
			type="com.sa.action.parametros.ParametrosMotivoLoadAction" name="ParametrosMotivoFiltroForm">
			<forward name="success" path="parametrosMotivo" />
			<forward name="parametrosMotivoFiltro" path="/pages/parametros/dtMotivos.jsp"/>
		</action>
	

		<action path="/parametrosMotivoDetalle"
			type="com.sa.action.parametros.ParametrosMotivoDetalleLoadAction"
			name="ParametrosMotivoForm">
			<forward name="alta" path="parametrosMotivoAlta" />
			<forward name="modificacion" path="parametrosMotivoModificacion" />
			<forward name="baja" path="parametrosMotivoBaja" />
		</action>
		
		<action path="/saveMotivo"
			type="com.sa.action.parametros.ParametrosMotivoSaveAction" name="ParametrosMotivoForm">
			<forward name="success" path="/parametrosMotivo.do" />
			<forward name="errorAlta" path="parametrosMotivoAlta" />
			<forward name="errorModificacion" path="parametrosMotivoModificacion" />
			<forward name="errorBaja" path="parametrosMotivoBaja" />
		</action>
		
		<action path="/parametrosGastos"
			type="com.sa.action.parametros.ParametrosGastosLoadAction" name="ParametrosGastosFiltroForm">
			<forward name="success" path="parametrosGastos" />
			<forward name="parametrosGastoFiltro" path="/pages/parametros/dtGastos.jsp"/> 
		</action>
		
		<action path="/parametrosGastosFiltro"
			type="com.sa.action.parametros.ParametrosGastosFiltroAction" name="ParametrosGastosFiltroForm">
			<forward name="success" path="parametrosGastos" />
		
		</action>
				
		<action path="/parametrosGastosDetalle"
			type="com.sa.action.parametros.ParametrosGastosDetalleLoadAction"
			name="ParametrosGastosForm">
			<forward name="alta" path="parametrosGastosAlta" />
			<forward name="modificacion" path="parametrosGastosModificacion" />
			<forward name="baja" path="parametrosGastosBaja" />
		</action>
		
		<action path="/saveGasto"
			type="com.sa.action.parametros.ParametrosGastosSaveAction" name="ParametrosGastosForm">
			<forward name="success" path="/parametrosGastos.do" />
			<forward name="fail" path="/parametrosGastosDetalle.do" />
		</action>
		
		<action path="/RistraPopUp" type="com.sa.action.RistraPopUpLoadAction"
			name="ParametrosGastosForm">
			<forward name="success" path="/pages/popups/ristraPopUp.jsp"/>
		</action>
		
		<action path="/RistraPopUpSave" type="com.sa.action.RistraPopUpSaveAction"
			name="ParametrosGastosForm">
			<forward name="success" path="/parametrosGastosDetalle.do"/>
		</action>
		
		<action path="/parametrosExceptuados"
			type="com.sa.action.parametros.ParametrosExceptuadosLoadAction" name="ParametrosExceptuadosFiltroForm">
			<forward name="success" path="parametrosExceptuados" />
		</action>
		
		<action path="/parametrosExceptuadosFiltro"
			type="com.sa.action.parametros.ParametrosExceptuadosFiltroAction"
			name="ParametrosExceptuadosFiltroForm">
			<forward name="success" path="parametrosExceptuados" />
			<forward name="exceptuados" path="/pages/parametros/dtExceptuados.jsp"/>
		</action>
		
		<action path="/parametrosExceptuadosDetalle"
			type="com.sa.action.parametros.ParametrosExceptuadosDetalleLoadAction"
			name="ParametrosExceptuadosForm">
			<forward name="alta" path="parametrosExceptuadosAlta" />
			<forward name="modificacion" path="parametrosExceptuadosModificacion" />
			<forward name="baja" path="parametrosExceptuadosBaja" />
		</action>
		
		<action path="/chequearCodigo"
			type="com.sa.action.parametros.CheckCodigoExceptuadosAction">
			
		</action>
		<action path="/saveExcepcion"
			type="com.sa.action.parametros.ParametrosExceptuadosSaveAction" name="ParametrosExceptuadosForm">
			<forward name="success" path="/parametrosExceptuados.do" />
			<forward name="fail" path="parametrosExceptuadosAlta" />
		</action>
		
		<action path="/parametrosAlertas"
			type="com.sa.action.parametros.ParametrosAlertasLoadAction" name="ParametrosAlertasFiltroForm">
			<forward name="success" path="parametrosAlertas" />
			<forward name="parametrosAlertaFiltro" path="/pages/parametros/dtAlertas.jsp"/>
		</action>
		
		<action path="/parametrosAlertasFiltro"
			type="com.sa.action.parametros.ParametrosAlertasFiltroAction" name="ParametrosAlertasFiltroForm">
			<forward name="success" path="parametrosAlertas" />
			<forward name="fail" path="/parametrosAlertas.do" />
			<forward name="parametrosAlertaFiltro" path="/pages/parametros/dtAlertas.jsp"/>
		</action>
		
		<action path="/parametrosAlertasDetalle"
			type="com.sa.action.parametros.ParametrosAlertasDetalleLoadAction"
			name="ParametrosAlertasForm">
			<forward name="alta" path="parametrosAlertasAlta" />
			<forward name="modificacion" path="parametrosAlertasModificacion" />
			<forward name="baja" path="parametrosAlertasBaja" />
		</action>
		
		<action path="/saveAlerta"
			type="com.sa.action.parametros.ParametrosAlertasSaveAction" name="ParametrosAlertasForm">
			<forward name="success" path="/parametrosAlertas.do" />
			<forward name="fail" path="/parametrosAlertasDetalle.do" />
		</action>
		
		<!-- REPORTERIA -->
		<action path="/cuadroGeneral" type="com.sa.action.CuadroGeneralLoadAction" name="CuadroFiltroForm">
			<forward name="success" path="cuadroGeneral" />
		</action>
		
		<action path="/cuadroGeneralFiltro" type="com.sa.action.CuadroGeneralFiltroAction" name="CuadroFiltroForm">
			<forward name="success" path="cuadroGeneral" />
			<forward name="fail" path="/cuadroGeneral.do" />
		</action>
		
		<action path="/CuadroDetallado" type="com.sa.action.CuadroDetalladoLoadAction"
			name="CuadroFiltroForm">
			<forward name="success" path="CuadroDetallado">
			</forward>
		</action>
		
		<action path="/FiltroCuadroDetallado" type="com.sa.action.CuadroDetalladoFiltroAction"
			name="CuadroFiltroForm">
			<forward name="ok" path="CuadroDetallado">
			</forward>
		</action>
		<!-- REDISTRIBUCION GASTOS -->
		<action path="/distribucionGastosLoad"
			type="com.sa.action.redistribucion.DistribucionGastosLoadAction">
			<forward name="success" path="distribucionGastosPage" />
		</action>
		<action path="/confirmDistribucionGasto"
			type="com.sa.action.redistribucion.DistribucionGastosConfirmAction">
		</action>
		<action path="/checkGastosMotivoDistribucion"
			type="com.sa.action.redistribucion.ParamsDistribucionGastosAction">
		</action>
		<action path="/obtenerDistribucionGasto"
			type="com.sa.action.redistribucion.BuscarGastosDistribuidosAction">
		</action>
		
		<action path="/combos" type="com.sa.action.CombosAction"
			className="com.sa.core.SecurityActionMapping" name="LoginForm">
		</action>
	</action-mappings>

	<!-- Controller Configuration ============================================= -->

	<controller processorClass="org.apache.struts.tiles.TilesRequestProcessor" />

	<!-- ========== Message Resources Definitions =========================== -->

	<message-resources parameter="config.i18n.MessageResources" />

	<!-- Plug Ins Configuration =============================================== -->


	<!-- Tiles plugin ======================================================== -->
	<plug-in className="org.apache.struts.tiles.TilesPlugin">
		<set-property property="definitions-config" value="/WEB-INF/tiles-defs.xml" />
	</plug-in>
</struts-config>